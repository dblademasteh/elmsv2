# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms_dev
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=lms_dev

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Security
# Generate strong random values, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-super-secret-key-for-development-only-change-in-production
JWT_SECRET_KEY=your-super-secret-jwt-key-for-development-only-change-in-production

# Server
PORT=8080

# Runtime mode: "development" enables local-only helpers (seed credentials,
# inline password-reset tokens, relaxed CORS). Never use it in production.
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
# Return password-reset tokens in the API response (local development only).
DEBUG_RESET_TOKEN=false

# JWT Settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256